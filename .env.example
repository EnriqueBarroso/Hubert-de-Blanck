# Copia este archivo como .env.local y rellena los valores reales.
# NO COMETAS .env.local AL REPO.

# URL pública de tu proyecto Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxx.supabase.co

# Anon key pública de Supabase (Project Settings > API)
VITE_SUPABASE_ANON_KEY=eyJ...

# Email del administrador (debe coincidir con el email de la cuenta admin
# y con el valor hardcoded en la función is_admin() del schema.sql)
VITE_ADMIN_EMAIL=admin@hubertdeblanck.com
